# Path to the Claude Code CLI binary. Defaults to `claude` on PATH.
# CLAUDE_CODE_PATH=/usr/local/bin/claude

# Colon-separated list of directories from which mcp_config_path may be read.
# Defaults to $HOME only. Absolute paths only; `..` is rejected after resolution.
# CLAUDE_BRIDGE_CONFIG_DIRS=/Users/me/configs:/etc/claude-bridge/configs

# Default working directory for spawned Claude Code subprocesses.
# Defaults to a fresh OS tempdir per session.
# CLAUDE_BRIDGE_DEFAULT_CWD=/tmp

# Set to "1" to allow callers to pass permissionMode=bypassPermissions.
# Default behavior rejects that mode entirely. Only enable if you fully understand
# what spawned subprocesses can do without user approval.
# CLAUDE_BRIDGE_ALLOW_BYPASS=0

# Idle timeout for persistent sessions, in seconds. Default: 300 (5 minutes).
# CLAUDE_BRIDGE_SESSION_IDLE_TIMEOUT=300

# Hard maximum lifetime for a persistent session, in seconds. Default: 3600 (1 hour).
# CLAUDE_BRIDGE_SESSION_MAX_LIFETIME=3600

# Per-call timeout for one-shot execute, in seconds. Default: 300 (5 minutes).
# CLAUDE_BRIDGE_EXECUTE_TIMEOUT=300

# Set to "1" to enable verbose debug logging on stderr. Logs are redacted for secrets.
# CLAUDE_BRIDGE_DEBUG=0

# Comma-separated env var names to pass through to spawned subprocesses,
# in addition to the safe default whitelist. Use sparingly.
# CLAUDE_BRIDGE_PASSTHROUGH_ENV=GITHUB_TOKEN,DATABASE_URL
